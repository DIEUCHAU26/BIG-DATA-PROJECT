          },
          {
            "name": "Most Expensive Product",
            "expression": [
              "",
              "CONCATENATEX(",
              "    TOPN(1, products, products[price], DESC, products[product_code], ASC),",
              "    products[name], \"\"",
              ")"
            ],
            "lineageTag": "a284b06a-b868-4c74-b905-1d66b21a05bc"
          },
          {
            "name": "Cheapest Product",
            "expression": [
              "",
