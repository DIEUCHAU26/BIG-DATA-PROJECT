          },
          {
            "name": "Rating Coverage %",
            "expression": [
              "",
              "DIVIDE(COUNT(products[rating]), COUNTROWS(products))"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "695fa1dd-1c63-426f-86ab-fa1215884f56"
          },
          {
            "name": "In Stock Rate",
            "expression": [
              "",
              "DIVIDE(SUM(products[in_stock]), COUNTROWS(products))"
            ],
            "formatString": "0%;-0%;0%",
            "lineageTag": "e79cef43-fffd-4724-ae85-67a57be8241c"
          },
          {
            "name": "Discounted Products %",
            "expression": [
              "",
              "DIVIDE(",
              "    CALCULATE(COUNTROWS(products), products[discount_pct] > 0),",
              "    COUNTROWS(products)",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "6cc1964d-f8fb-43a5-b274-99e0ef1eb969"
          },
          {
            "name": "Avg Saving VND",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"vi-VN\"}"
              }
            ],
            "expression": [
              "",
              "AVERAGEX(products, products[price_original] - products[price])",
              ""
            ],
            "formatString": "#,0\\ \"₫\";-#,0\\ \"₫\";#,0\\ \"₫\"",
            "lineageTag": "64d0ad89-66b4-4c00-be8d-4c8d6fee0ed0"
          },
          {
            "name": "Source Share %",
            "expression": [
              "",
              "DIVIDE(",
              "    COUNTROWS(products),",
              "    CALCULATE(COUNTROWS(products), ALL(products[source]))",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "d451ba3d-d9db-4acd-8924-afec4dc5885b"
          },
          {
            "name": "Weighted Rating",
            "expression": [
              "",
              "VAR v = SUM(products[review_count])",
              "VAR r = AVERAGE(products[rating])",
              "VAR c = CALCULATE(AVERAGE(products[rating]), ALL(products))",
              "VAR m = 10",
              "RETURN IF(ISBLANK(r), BLANK(), DIVIDE(v, v + m) * r + DIVIDE(m, v + m) * c)"
            ],
            "formatString": "0.00",
            "lineageTag": "5ceb2a23-8d53-491c-8ca2-c5aab6e9b3d9"
          },
