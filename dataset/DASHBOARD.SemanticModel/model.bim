          },
          {
            "name": "price_segment",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "SWITCH(",
              "    TRUE(),",
              "    products[price] < 100000, \"Bình dân (<100K)\",",
              "    products[price] < 300000, \"Trung cấp (100-300K)\",",
              "    products[price] < 700000, \"Cao cấp (300-700K)\",",
              "    \"Luxury (>700K)\"",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "b5c77487-57c6-440d-8b45-6e8f959ec13c",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "discount_band",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "SWITCH(",
              "    TRUE(),",
              "    products[discount_pct] = 0, \"Không giảm\",",
              "    products[discount_pct] <= 20, \"Giảm 1-20%\",",
              "    products[discount_pct] <= 40, \"Giảm 21-40%\",",
              "    products[discount_pct] <= 60, \"Giảm 41-60%\",",
              "    \"Giảm trên 60%\"",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "79e36246-667f-4c02-a88d-87850db509c9",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "rating_band",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "IF(",
              "    ISBLANK(products[rating]), \"Chưa có đánh giá\",",
              "    IF(products[rating] < 4.5, \"Dưới 4.5\",",
              "    IF(products[rating] < 5, \"Từ 4.5 đến 4.9\", \"Đạt 5.0\"))",
              ")"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "bd4d574b-eb95-4e0d-807c-2e669268c525",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "stock_status",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": "IF(products[in_stock] = 1, \"Còn hàng\", \"Hết hàng\")",
            "isDataTypeInferred": true,
            "lineageTag": "de7799e9-4021-4037-9379-6d9ae9eb8116",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "price (bins)",
            "annotations": [
              {
                "name": "GroupingDesignState",
                "value": "{\"Version\":0,\"Sources\":[{\"Name\":\"p\",\"Entity\":\"products\"}],\"GroupedColumns\":[{\"Column\":{\"Expression\":{\"SourceRef\":{\"Source\":\"p\"}},\"Property\":\"price\"}}],\"BinItem\":{\"Expression\":{\"Floor\":{\"Expression\":{\"Column\":{\"Expression\":{\"SourceRef\":{\"Source\":\"p\"}},\"Property\":\"price\"}},\"Size\":100000.0}}}}"
              },
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": [
              "IF(",
              "\tISBLANK('products'[price]),",
              "\tBLANK(),",
              "\tINT('products'[price] / 100000) * 100000",
              ")"
            ],
            "extendedProperties": [
              {
