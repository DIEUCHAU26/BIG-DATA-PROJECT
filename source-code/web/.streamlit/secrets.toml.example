# Copy this file to secrets.toml and replace MONGO_URI with your own connection string.
# Keep secrets.toml private; it is ignored by Git.
MONGO_URI = "mongodb+srv://DB_USER:DB_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGO_DB = "DATA"
# Collection used directly for all product reads and writes.
MONGO_PRODUCTS_COLLECTION = "product_clean"
